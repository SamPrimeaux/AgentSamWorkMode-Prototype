From ec665625e527f8753bd3875be953b76c5c42fecc Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 1 Sep 2026 15:43:17 +0000
Subject: [PATCH 2/3] fix(cli): pin agentsam-sdk from GitHub and forward SDK
 verbs

The npm alpha.12 tarball lagged git main (missing status/db/tui). Pin
@inneranimalmedia/agentsam-sdk to github:SamPrimeaux/agentsam-sdk@607ce23
and delegate any non-host verb to the installed SDK CLI automatically.
---
 bin/README.md          |  9 ++++---
 bin/agentsam           | 23 +++++++++---------
 bin/commands/index.mjs |  7 +++++-
 package-lock.json      | 55 +++++++++++++++++++++++++++++-------------
 package.json           |  4 ++-
 test/bin-lib.test.mjs  | 11 +++++++++
 6 files changed, 75 insertions(+), 34 deletions(-)

diff --git a/bin/README.md b/bin/README.md
index effbf68..ce14cfd 100644
--- a/bin/README.md
+++ b/bin/README.md
@@ -8,17 +8,18 @@ Primary entrypoint:
 
 ```text
 bin/agentsam
-├── context|init|start-local|tunnel|identity|shell  → installed SDK CLI
+├── context|init|status|db|tui|start-local|tunnel|identity|shell  → installed SDK CLI
 ├── acp serve                                      → Remix host command
-├── deploy full|fast|worker                        → Remix host command
+├── deploy full|fast|worker                        → Remix host command (overrides SDK deploy)
 ├── eval retrieval                                 → Remix host command
 ├── sdk status                                     → SDK integration status
 └── website sync|watch|status|verify|rollback      → Remix host command
 ```
 
 Portable verbs and `--version` resolve the executable declared by the installed
-`@inneranimalmedia/agentsam-sdk` package. Remix does not copy their command
-implementations. Host-specific verbs remain here because they operate this repository.
+`@inneranimalmedia/agentsam-sdk` package. Any verb that is not a Remix host command
+(`acp`, `deploy`, `eval`, `sdk`, `website`) is forwarded to the SDK CLI automatically.
+Remix does not copy SDK command implementations.
 
 Supporting executable implementations currently live in `bin/deploy` and
 `bin/website-assets.mjs`; command dispatch modules live in `bin/commands/`.
diff --git a/bin/agentsam b/bin/agentsam
index 4dfc859..72ac3d9 100755
--- a/bin/agentsam
+++ b/bin/agentsam
@@ -14,7 +14,9 @@ import { COMMANDS, usage, resolveVerb } from './commands/index.mjs';
 
 const require = createRequire(import.meta.url);
 const SDK_PACKAGE = '@inneranimalmedia/agentsam-sdk';
-const SDK_VERBS = new Set(['context', 'init', 'start-local', 'tunnel', 'identity', 'shell']);
+
+/** Remix-owned verbs — these override same-named SDK commands when both exist (e.g. deploy). */
+const HOST_VERBS = new Set(Object.keys(COMMANDS));
 
 function resolveSdkCli() {
   const packagePath = require.resolve(`${SDK_PACKAGE}/package.json`);
@@ -59,18 +61,17 @@ function main(argv) {
     return;
   }
 
-  const [verb, ...rest] = argv;
-  if (SDK_VERBS.has(verb)) return runSdkCli(argv);
-
+  const [verb] = argv;
   const key = resolveVerb(verb);
-  const cmd = COMMANDS[key];
-  if (!cmd) {
-    console.error(`unknown verb: ${verb}`);
-    usage();
-    process.exitCode = 2;
-    return;
+
+  if (HOST_VERBS.has(key)) {
+    const cmd = COMMANDS[key];
+    return cmd(argv.slice(1));
   }
-  return cmd(rest);
+
+  // All other verbs execute the installed @inneranimalmedia/agentsam-sdk CLI
+  // (context, init, status, db, tui, start-local, tunnel, identity, shell, …).
+  return runSdkCli(argv);
 }
 
 Promise.resolve(main(process.argv.slice(2))).catch((error) => {
