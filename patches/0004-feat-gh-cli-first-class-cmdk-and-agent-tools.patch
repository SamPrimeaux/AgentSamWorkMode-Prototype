--- /dev/null
+++ b/test/gh-command-catalog.test.mjs
@@ -0,0 +1,80 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  GH_COMMAND_CATALOG,
+  filterGhCatalog,
+  groupGhCatalog,
+  normalizeGhCommandRow,
+  isGhCatalogEntry,
+} from '../app/lib/ghCommandCatalog.ts';
+import {
+  isGhCommand,
+  isGhLoginCommand,
+  normalizeGhCommandForLane,
+  ghTerminalRecoveryHints,
+} from '../src/core/gh-terminal-guidance.js';
+
+test('gh catalog has core PR and auth commands', () => {
+  assert.ok(GH_COMMAND_CATALOG.length >= 50);
+  const names = GH_COMMAND_CATALOG.map((c) => c.mapped_command);
+  assert.ok(names.some((c) => c.startsWith('gh auth status')));
+  assert.ok(names.some((c) => c.startsWith('gh pr list')));
+  assert.ok(names.some((c) => c.startsWith('gh run list')));
+});
+
+test('filterGhCatalog finds pr commands', () => {
+  const rows = filterGhCatalog('pr merge', 20);
+  assert.ok(rows.length >= 1);
+  assert.ok(rows.every((r) => /pr|merge/i.test(`${r.display_name} ${r.mapped_command}`)));
+});
+
+test('groupGhCatalog preserves category order', () => {
+  const grouped = groupGhCatalog(GH_COMMAND_CATALOG);
+  assert.equal(grouped[0]?.category, 'auth');
+  assert.ok(grouped.some((g) => g.category === 'pr'));
+});
+
+test('normalizeGhCommandRow accepts D1 palette rows', () => {
+  const row = normalizeGhCommandRow({
+    id: 'cmd_gh_pr-list',
+    slug: '/gh/pr-list',
+    display_name: 'PR list',
+    shell_line: 'gh pr list',
+    category: 'pr',
+    sort_order: 10,
+  });
+  assert.ok(row);
+  assert.equal(row?.mapped_command, 'gh pr list');
+  assert.equal(row?.category, 'pr');
+});
+
+test('isGhCatalogEntry detects gh slugs', () => {
+  assert.equal(isGhCatalogEntry({ slug: '/gh/pr-list', mapped_command: '' }), true);
+  assert.equal(isGhCatalogEntry({ mapped_command: 'git status' }), false);
+});
+
+test('gh lane policy blocks interactive login in sandbox', () => {
+  const out = normalizeGhCommandForLane('gh auth login', 'sandbox');
+  assert.equal(out.ok, false);
+  assert.match(String(out.error), /sandbox/i);
+});
+
+test('gh lane policy allows token login in sandbox', () => {
+  const out = normalizeGhCommandForLane('gh auth login --with-token', 'sandbox');
+  assert.equal(out.ok, true);
+});
+
+test('gh terminal recovery hints for auth errors', () => {
+  const hints = ghTerminalRecoveryHints({
+    stderr: 'HTTP 401: Bad credentials',
+    command: 'gh pr list',
+  });
+  assert.ok(hints.some((h) => h.code === 'gh_auth_missing'));
+});
+
+test('isGhCommand and isGhLoginCommand', () => {
+  assert.equal(isGhCommand('gh pr list'), true);
+  assert.equal(isGhCommand('git status'), false);
+  assert.equal(isGhLoginCommand('gh auth login'), true);
+  assert.equal(isGhLoginCommand('gh auth status'), false);
+});
