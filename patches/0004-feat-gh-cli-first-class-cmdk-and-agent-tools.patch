diff --git a/src/core/gh-terminal-guidance.js b/src/core/gh-terminal-guidance.js
new file mode 100644
index 0000000..c5aed67
--- /dev/null
+++ b/src/core/gh-terminal-guidance.js
@@ -0,0 +1,234 @@
+/**
+ * GitHub CLI (gh) auth + lane guidance — mirrors wrangler-terminal-guidance.js.
+ * @see https://cli.github.com/manual/
+ *
+ * Lane law:
+ * - local (Mac PTY): gh auth login OAuth in browser
+ * - remote (GCP VM): GH_TOKEN / GITHUB_TOKEN from OAuth sync (headless)
+ * - sandbox (CF container): injected GH_TOKEN from user GitHub OAuth — never gh auth login OAuth
+ */
+
+/** @typedef {'local'|'remote'|'sandbox'|'auto'} TerminalAuthLane */
+
+export const GH_DOCS_URL = 'https://cli.github.com/manual/';
+
+/** General gh commands (Cmd+K + terminal help). */
+export const GH_GENERAL_COMMANDS = Object.freeze([
+  {
+    id: 'gh-docs',
+    label: 'Open gh manual',
+    command: 'gh help',
+    lane: 'all',
+    notes: 'Full CLI reference at cli.github.com.',
+  },
+  {
+    id: 'gh-version',
+    label: 'Version',
+    command: 'gh --version',
+    lane: 'all',
+  },
+  {
+    id: 'gh-auth-status',
+    label: 'Auth status',
+    command: 'gh auth status',
+    lane: 'all',
+    notes: 'Verify token scopes. Use --show-token in trusted environments only.',
+  },
+  {
+    id: 'gh-auth-login-local',
+    label: 'Login (local Mac only)',
+    command: 'gh auth login',
+    lane: 'local',
+    notes: 'Interactive OAuth in browser. Do not use in CF container sandbox.',
+  },
+  {
+    id: 'gh-auth-login-token',
+    label: 'Login with token (stdin)',
+    command: 'gh auth login --with-token',
+    lane: 'sandbox',
+    notes: 'Pipe GH_TOKEN on stdin for headless / CI.',
+  },
+  {
+    id: 'gh-auth-setup-git',
+    label: 'Setup git credentials',
+    command: 'gh auth setup-git',
+    lane: 'all',
+  },
+]);
+
+/**
+ * @param {string} command
+ */
+export function isGhCommand(command) {
+  return /(^|[\s;&|])gh(\s|$)/i.test(String(command || ''));
+}
+
+/**
+ * @param {string} command
+ */
+export function isGhLoginCommand(command) {
+  return /\bgh\s+auth\s+login\b/i.test(String(command || ''));
+}
+
+/**
+ * @param {TerminalAuthLane} lane
+ */
+export function ghAuthGuideForLane(lane) {
+  const l = String(lane || 'auto').trim().toLowerCase();
+  if (l === 'local') {
+    return {
+      lane: 'local',
+      title: 'GitHub CLI on your Mac',
+      summary: 'Run gh auth login once (OAuth). Then gh pr, gh run, gh repo from the local PTY.',
+      recommended: ['gh auth login', 'gh auth status', 'gh auth setup-git', 'gh pr list'],
+      avoid: ['Do not expect OAuth callback inside CF container.'],
+    };
+  }
+  if (l === 'remote') {
+    return {
+      lane: 'remote',
+      title: 'GitHub CLI on cloud desk (GCP)',
+      summary:
+        'Headless VM — export GH_TOKEN from OAuth sync or gh auth token. Prefer gh auth status before mutations.',
+      recommended: ['gh auth status', 'gh pr list', 'gh run list', 'gh repo view'],
+      avoid: ['gh auth login without browser tunnel unless using --with-token.'],
+    };
+  }
+  return {
+    lane: 'sandbox',
+    title: 'GitHub CLI in CF container sandbox',
+    summary:
+      'Agent Sam injects GH_TOKEN from your GitHub OAuth. Use gh auth status — not gh auth login OAuth.',
+    recommended: [
+      'gh auth status',
+      'gh pr list --json number,title,state',
+      'gh run list --limit 10',
+      'gh repo view --json name,url',
+    ],
+    avoid: [
+      'gh auth login (interactive OAuth hangs in container).',
+      'Use agentsam_github_* REST tools when gh is unavailable.',
+    ],
+    docs: GH_DOCS_URL,
+  };
+}
+
+/**
+ * Block or rewrite gh auth login per lane before container/remote exec.
+ * @param {string} command
+ * @param {TerminalAuthLane} lane
+ */
+export function normalizeGhCommandForLane(command, lane) {
+  const cmd = String(command || '').trim();
+  if (!cmd) return { ok: true, command: cmd };
+  if (!isGhLoginCommand(cmd)) return { ok: true, command: cmd };
+  if (/--with-token/i.test(cmd)) return { ok: true, command: cmd };
+
+  const l = String(lane || 'sandbox').trim().toLowerCase();
+  const guide = ghAuthGuideForLane(l === 'remote' ? 'remote' : l === 'local' ? 'local' : 'sandbox');
+
+  if (l === 'sandbox' || l === 'auto') {
+    return {
+      ok: false,
+      error:
+        'gh auth login OAuth does not work in CF sandbox. ' +
+        'Connect GitHub OAuth in Keys, then run: gh auth status',
+      guidance: guide,
+    };
+  }
+
+  return { ok: true, command: cmd };
+}
+
+/**
+ * Prefix shell exports for headless gh in container (per-user GitHub OAuth).
+ * @param {any} env
+ * @param {{ id?: string, user_id?: string, auth_id?: string }|null} authUser
+ */
+export async function buildContainerGhEnvPrefix(env, authUser) {
+  const userId = authUser?.id || authUser?.user_id || authUser?.auth_id;
+  if (!userId) return '';
+
+  const { resolveSandboxGithubToken } = await import('./sandbox-github-git-helper.js');
+  const tok = await resolveSandboxGithubToken(env, userId);
+  if (!tok?.token) return '';
+
+  const tokenQ = shellQuote(tok.token);
+  return [
+    `export GH_TOKEN=${tokenQ}`,
+    `export GITHUB_TOKEN=${tokenQ}`,
+    'export GIT_TERMINAL_PROMPT=0',
+  ].join(' && ');
+}
+
+/**
+ * @param {string} raw
+ */
+function shellQuote(raw) {
+  const s = String(raw || '');
+  if (!/[\s'"$`\\]/.test(s)) return s;
+  return `'${s.replace(/'/g, `'\\''`)}'`;
+}
+
+/**
+ * Apply env prefix + lane normalization to a container exec command.
+ * @param {any} env
+ * @param {{ id?: string, user_id?: string, auth_id?: string }|null} authUser
+ * @param {string} command
+ * @param {TerminalAuthLane} [lane]
+ */
+export async function prepareContainerGhCommand(env, authUser, command, lane = 'sandbox') {
+  const norm = normalizeGhCommandForLane(command, lane);
+  if (!norm.ok) {
+    return { ok: false, error: norm.error, guidance: norm.guidance };
+  }
+  const prefix = await buildContainerGhEnvPrefix(env, authUser);
+  const cmd = norm.command;
+  if (isGhCommand(cmd) && !prefix && !/^(gh\s+(auth\s+status|--version|help)\b)/i.test(cmd)) {
+    return {
+      ok: false,
+      error:
+        'GH_TOKEN could not be injected into the sandbox. Connect GitHub OAuth (Settings → Keys) or use agentsam_github_* REST tools.',
+      guidance: ghAuthGuideForLane('sandbox'),
+    };
+  }
+  if (!prefix) return { ok: true, command: cmd };
+  return { ok: true, command: `${prefix} && ${cmd}` };
+}
+
+/**
+ * gh-specific recovery hints appended to terminal tool output.
+ * @param {{ stdout?: string, stderr?: string, command?: string }} opts
+ */
+export function ghTerminalRecoveryHints(opts = {}) {
+  const text = `${opts.stdout ?? ''}\n${opts.stderr ?? ''}\n${opts.command ?? ''}`;
+  const hints = [];
+
+  if (/HTTP 401|Bad credentials|authentication required|GH_TOKEN|GITHUB_TOKEN|not logged in/i.test(text)) {
+    hints.push({
+      code: 'gh_auth_missing',
+      action:
+        'Connect GitHub OAuth in Settings → Keys, then gh auth status. Local: gh auth login. Sandbox: uses injected GH_TOKEN.',
+    });
+  }
+  if (/missing required scopes|insufficient scopes|403 Forbidden/i.test(text) && isGhCommand(opts.command || text)) {
+    hints.push({
+      code: 'gh_scope_missing',
+      action: 'Reconnect GitHub OAuth with repo/workflow scopes, or run: gh auth refresh -s repo,workflow',
+    });
+  }
+  if (/command not found.*\bgh\b/i.test(text)) {
+    hints.push({
+      code: 'gh_not_installed',
+      action: 'Install GitHub CLI: brew install gh (Mac) or see https://cli.github.com/',
+    });
+  }
+  if (/auth login.*device/i.test(text) && isGhLoginCommand(opts.command || text)) {
+    hints.push({
+      code: 'gh_login_device',
+      action: 'Device flow in sandbox may hang — use GH_TOKEN via OAuth or agentsam_github_* tools instead.',
+    });
+  }
+
+  return hints;
+}
