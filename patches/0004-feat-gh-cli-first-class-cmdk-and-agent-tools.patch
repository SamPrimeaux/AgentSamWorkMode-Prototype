new file mode 100644
index 0000000..e24e523
--- /dev/null
+++ b/src/api/terminal-gh-guide.js
@@ -0,0 +1,71 @@
+/**
+ * GET /api/terminal/gh-guide — lane-aware GitHub CLI auth paths (no secrets).
+ */
+import { getAuthUser, jsonResponse } from '../core/auth.js';
+import {
+  GH_GENERAL_COMMANDS,
+  GH_DOCS_URL,
+  ghAuthGuideForLane,
+} from '../core/gh-terminal-guidance.js';
+import { probeMyContainer } from '../../backend/agentsam/sandbox/my-container.js';
+
+/**
+ * @param {Request} request
+ * @param {URL} url
+ * @param {any} env
+ */
+export async function handleTerminalGhGuide(request, url, env) {
+  if (request.method.toUpperCase() !== 'GET') {
+    return jsonResponse({ error: 'Method not allowed' }, 405);
+  }
+
+  const authUser = await getAuthUser(request, env);
+  if (!authUser) return jsonResponse({ error: 'Unauthorized' }, 401);
+
+  const laneParam = url.searchParams.get('lane') || 'sandbox';
+  const lane =
+    laneParam === 'local' || laneParam === 'remote' || laneParam === 'sandbox' || laneParam === 'auto'
+      ? laneParam
+      : 'sandbox';
+  const wantStatus =
+    url.searchParams.get('status') === '1' || url.searchParams.get('exec') === '1';
+
+  const guide = ghAuthGuideForLane(lane);
+  let probe = null;
+  let gh_auth_status = null;
+  if (lane === 'sandbox' && wantStatus) {
+    probe = await probeMyContainer(env);
+    if (probe.ok) {
+      const { prepareContainerGhCommand } = await import('../core/gh-terminal-guidance.js');
+      const { tryContainerExec } = await import('../../backend/agentsam/sandbox/my-container.js');
+      const prep = await prepareContainerGhCommand(
+        env,
+        authUser,
+        'gh auth status 2>&1',
+        'sandbox',
+      );
+      if (prep.ok) {
+        gh_auth_status = await tryContainerExec(env, {
+          command: prep.command,
+          cwd: '/tmp',
+          timeout_ms: 25_000,
+          authUser,
+          skip_gh_normalize: true,
+        });
+      } else {
+        gh_auth_status = { ok: false, error: prep.error, guidance: prep.guidance };
+      }
+    }
+  }
+
+  return jsonResponse({
+    ok: true,
+    docs: GH_DOCS_URL,
+    lane,
+    guide,
+    general_commands: GH_GENERAL_COMMANDS,
+    container_probe: probe,
+    gh_auth_status,
+    checked_at: Date.now(),
+  });
+}
