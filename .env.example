# ==========================================
# Agent Sam Work Mode - Environment Configuration
# ==========================================
# All variables prefixed with VITE_ are accessible to the client runtime.
# Sensitive backend secrets (such as GEMINI_API_KEY) MUST NEVER have VITE_ prefix.

# Server-Side Secrets (DO NOT COMMIT REAL VALUES)
GEMINI_API_KEY=

# Client Runtime Configuration & Identity
VITE_APP_TITLE=Agent Sam Work Mode - Execution Agent
VITE_APP_NAME=Agent Sam
VITE_AGENT_ROLE=Lead Execution & Full-Stack Orchestrator
VITE_AGENT_INITIALS=AS

# Developer Identity & User Context
VITE_USER_EMAIL=info@inneranimals.com
VITE_USER_NAME=Developer
VITE_USER_INITIALS=DV
VITE_ORGANIZATION=inneranimals
VITE_TENANT_ID=org_main

# Workspace & Git Defaults
VITE_DEFAULT_BRANCH=main
VITE_DEFAULT_WORKSPACE_PATH=backend/agentsam
VITE_DEFAULT_MODEL=gemini-3.5-flash

# ExecOS Local Lane & Bridge Configuration
VITE_EXECOS_PORT=3099
VITE_EXECOS_TUNNEL_URL=https://user-hosted-tunnel.agentsam.dev
VITE_EXECOS_WORKER_URL=https://api.agentsam.dev/agent
VITE_EXECOS_MAC_USER=developer

# Client Brand & Pitch Presentation Context
VITE_CLIENT_BRAND_NAME=Apex Dynamics
VITE_CLIENT_TAGLINE=Precision AI Execution for Visionary Enterprises
VITE_CLIENT_MISSION=Empowering ambitious teams to turn bold creative concepts into production-grade digital reality in seconds.

# Infrastructure & Edge Telemetry
VITE_EDGE_REGION=iad1 (US East)
VITE_API_BASE_URL=/api
