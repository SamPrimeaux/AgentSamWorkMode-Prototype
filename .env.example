# AgentSamRemix platform APIs (optional — enables git, terminal, CMS, artifacts)
VITE_IAM_ORIGIN=https://agentsamremix.inneranimalmedia.com
VITE_WORKSPACE_ID=

# Storage backend: local | cloudflare | gdrive (default: cloudflare when IAM set)
VITE_STORAGE_BACKEND=cloudflare

# Local Gemini fallback when not using platform agent chat
GEMINI_API_KEY=

# Local bridge (agentsam-bridge run) — PTY + Monaco file I/O
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3099

# Dev-only: mock user for pairing when IAM session cookie is absent
MOCK_PAIR_USER_ID=dev_user
